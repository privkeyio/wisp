.{
    .name = .wisp,
    .version = "0.9.0",
    .fingerprint = 0xc4bdec9fe6401a8d,
    .dependencies = .{
        // websocket.zig: client for spider outbound connections and the epoll
        // worker-pool server. Upstream, includes the TLS read-readiness poll fix
        // (#103), the in-loop re-poll that stops quiet wss connections busy-spinning
        // a core (via #218/#219 pin bumps), and the bounded connect/TLS-handshake
        // timeout (#108), the restored TLS buffered-record read fix (#111), the
        // FallbackAllocator resize fix (#113), and Zig 0.17 support. Must match
        // http.zig's websocket pin so the two resolve to one package.
        .websocket = .{
            .url = "https://github.com/karlseguin/websocket.zig/archive/f2b3bad6875595e8dd42c726e8e914885a8b0ba0.tar.gz",
            .hash = "websocket-0.1.0-ZPISdbERBQCnk2-UDVSJlOss6POs_aAJR2nrccYJ1wZm",
        },
        .nostr = .{
            .url = "https://github.com/privkeyio/libnostr-z/archive/5accad27a7ad71d503cd3c8152ea9540d2c23cda.tar.gz",
            .hash = "nostr-0.5.0-JY6OcKMgEABIisCx3kmE4ybZbmnO5PyWyodAGjukxEJs",
        },
        // http.zig: HTTP routing (NIP-11/NIP-86) + WebSocket upgrade onto
        // websocket.zig's epoll worker pool.
        //
        // Vendored (see vendor/httpz) from the upstream commit recorded in
        // vendor/httpz.commit (Zig 0.17). Upstream now carries the
        // timeout-sweep fix (a sweep containing both expired and surviving
        // connections dropped every survivor from the tracking list), the
        // .acquire ordering on acquireProcessing that the local patch below
        // depends on, and the handover double-close fix: conns detached from
        // handover_list are freed through release() rather than disown(), and
        // shutdown no longer closes a socket that was disowned or upgraded. Its
        // websocket pin matches the one above.
        //
        // What remains local, recorded in vendor/httpz.patch and enforced by
        // scripts/verify-vendored-httpz.sh in CI: reclaiming the per-worker slot
        // (self.len) and freeing the Conn wrapper when a WebSocket closes
        // (accept-stall leak), publishing a handover only after the HTTPConn
        // mutex is released and waiting out a held mutex before recycling an
        // HTTPConn, single-owner teardown in accept(), never calling
        // handover_list.remove() on a detached node, guarding the handover and
        // shutdown union reads against a .websocket conn, routing every slot
        // release through a guarded helper, and a connectionCount() accessor
        // the watchdog reads as a liveness signal.
        //
        // Kept as a path dependency so a clean `zig build` (incl. the StartOS
        // Docker fetch) builds this tree with no external fork.
        .httpz = .{
            .path = "vendor/httpz",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
    },
}
